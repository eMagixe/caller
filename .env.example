# Обязательно для production: публичный HTTPS origin, без завершающего слеша.
NUXT_APP_ORIGIN=https://caller.magixe-dev.ru
# Порт Docker Compose на хосте; внутри контейнера приложение слушает 3000.
CALLER_PORT=3000
# Включайте только за доверенным прокси, который заменяет X-Forwarded-For.
NUXT_TRUST_PROXY=false
# Необязательно локально; для работы между разными сетями настройте coturn.
NUXT_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Тот же static-auth-secret, что у coturn. Никогда не добавляйте его в public config.
NUXT_TURN_SECRET=
NUXT_STUN_URLS=stun:stun.cloudflare.com:3478
